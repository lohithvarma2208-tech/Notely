// Notely — marketplace for student note-writing services
// NOTE: SQLite does not support Prisma enums. Controlled vocabularies are
// plain Strings here; the allowed values live in src/lib/constants.ts and are
// enforced by zod in API routes and by the order state machine in
// src/lib/order-machine.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  phone        String?  @unique
  avatarUrl    String?
  college      String?
  isAdmin      Boolean  @default(false)
  // subscription: every user gets a free trial, then pays a monthly fee
  // (price + trial length live in PlatformConfig, editable from /admin)
  trialEndsAt            DateTime?
  subscriptionPaidUntil  DateTime?
  createdAt    DateTime @default(now())

  writerProfile WriterProfile?
  requests      NoteRequest[]   @relation("StudentRequests")
  offers        Offer[]
  studentOrders Order[]         @relation("StudentOrders")
  writerOrders  Order[]         @relation("WriterOrders")
  messages      Message[]
  reviewsGiven  Review[]        @relation("ReviewsGiven")
  reviewsGot    Review[]        @relation("ReviewsReceived")
  transactions  Transaction[]
  notifications Notification[]
}

model WriterProfile {
  id                  String  @id @default(cuid())
  userId              String  @unique
  user                User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  title               String  @default("Note Writer")
  bio                 String  @default("")
  location            String  @default("")
  // comma-separated lists, e.g. "English,Telugu"
  languages           String  @default("")
  subjects            String  @default("")
  handwritingStyles   String  @default("")
  pricePerPage        Int     @default(8) // ₹ per handwritten page
  digitalPricePerPage Int     @default(5) // ₹ per digital page
  minOrderValue       Int     @default(100)
  availability        String  @default("AVAILABLE") // AVAILABLE | BUSY | AWAY
  turnaroundDays      Int     @default(2) // typical days per 40 pages
  identityVerified    Boolean @default(false)
  phoneVerified       Boolean @default(false)
  acceptsDigital      Boolean @default(true)
  acceptsHandwritten  Boolean @default(true)
  // denormalized stats — maintained by API code, badges derive from these
  jobsCompleted       Int     @default(0)
  totalPagesWritten   Int     @default(0)
  onTimePercent       Float   @default(100)
  avgResponseMins     Int     @default(60)
  ratingAvg           Float   @default(0)
  ratingCount         Int     @default(0)
  createdAt           DateTime @default(now())

  samples HandwritingSample[]
}

model HandwritingSample {
  id         String  @id @default(cuid())
  writerId   String
  writer     WriterProfile @relation(fields: [writerId], references: [id], onDelete: Cascade)
  title      String
  style      String  // NORMAL | NEAT | VERY_NEAT | HEADINGS | DIAGRAMS | MATH | CODE
  fontKey    String  @default("hand") // hand | hand2 | hand3 — rendered with handwriting fonts
  sampleText String
  imageUrl   String?
  sortOrder  Int     @default(0)
}

model NoteRequest {
  id            String   @id @default(cuid())
  studentId     String
  student       User     @relation("StudentRequests", fields: [studentId], references: [id], onDelete: Cascade)
  title         String
  subject       String
  noteType      String   // HANDWRITTEN | DIGITAL | REWRITE | PHOTO_TO_CLEAN | PDF_TO_HANDWRITTEN | NOTEBOOK_COMPLETION
  instructions  String   @default("")
  estPages      Int?
  pagesUnknown  Boolean  @default(false)
  writingStyle  String   @default("NEAT") // NORMAL | NEAT | VERY_NEAT | EXAM_REVISION | DETAILED | COMPACT | CUSTOM
  // notebook requirements (physical work)
  notebookSize  String?  // A4 | A5 | LONG | RECORD | CUSTOM
  ruled         String?  // RULED | UNRULED
  sides         String?  // SINGLE | BOTH
  penColor      String?  // BLUE | BLACK | CUSTOM
  margins       Boolean  @default(false)
  headingStyle  String?
  diagramReqs   String?
  deliveryMethod String  @default("DIGITAL") // DIGITAL | PHYSICAL
  deliveryNotes String?
  deadline      DateTime
  budgetMin     Int
  budgetMax     Int
  status        String   @default("OPEN") // OPEN | IN_ORDER | CLOSED | CANCELLED
  offerCount    Int      @default(0)
  createdAt     DateTime @default(now())

  sources SourceFile[]
  offers  Offer[]
  order   Order?
}

model SourceFile {
  id        String  @id @default(cuid())
  requestId String
  request   NoteRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  fileName  String
  fileType  String  // PDF | IMAGE | DOCX | PPTX | OTHER
  url       String
  sizeKb    Int     @default(0)
}

model Offer {
  id            String   @id @default(cuid())
  requestId     String
  request       NoteRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  writerId      String
  writer        User     @relation(fields: [writerId], references: [id], onDelete: Cascade)
  priceType     String   @default("TOTAL") // TOTAL | PER_PAGE
  totalPrice    Int
  pricePerPage  Int?
  estimatedDays Int
  message       String   @default("")
  status        String   @default("PENDING") // PENDING | ACCEPTED | DECLINED | WITHDRAWN
  createdAt     DateTime @default(now())

  order Order?

  @@unique([requestId, writerId])
}

model Order {
  id             String   @id @default(cuid())
  requestId      String   @unique
  request        NoteRequest @relation(fields: [requestId], references: [id])
  offerId        String   @unique
  offer          Offer    @relation(fields: [offerId], references: [id])
  studentId      String
  student        User     @relation("StudentOrders", fields: [studentId], references: [id])
  writerId       String
  writer         User     @relation("WriterOrders", fields: [writerId], references: [id])
  status         String   @default("AWAITING_PAYMENT")
  // POSTED | OFFERS_RECEIVED | AWAITING_PAYMENT | FUNDED | IN_PROGRESS |
  // READY_FOR_REVIEW | REVISION_REQUESTED | APPROVED | COMPLETED |
  // CANCELLED | DISPUTED | REFUNDED
  totalPages     Int
  agreedPrice    Int      // ₹ total
  pricePerPage   Int?
  platformFeePct Float    // snapshot of config at order creation — never hardcoded
  platformFee    Int      // ₹
  writerEarning  Int      // ₹
  pagesCompleted Int      @default(0)
  deadline       DateTime
  deliveryMethod String   @default("DIGITAL")
  deliveryStatus String?  // PENDING | HANDED_OFF | IN_TRANSIT | DELIVERED
  trackingRef    String?
  deliveryFiles  String   @default("[]") // JSON array of {fileName,url,fileType,sizeKb}
  paymentId      String?
  paymentMode    String?  // RAZORPAY | MOCK
  paidAt         DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  completedAt    DateTime?

  progress ProgressUpdate[]
  messages Message[]
  review   Review?
}

model ProgressUpdate {
  id             String   @id @default(cuid())
  orderId        String
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  pagesCompleted Int
  note           String   @default("")
  photoUrl       String?
  createdAt      DateTime @default(now())
}

model Message {
  id             String   @id @default(cuid())
  orderId        String
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User     @relation(fields: [senderId], references: [id])
  body           String   @default("")
  attachmentUrl  String?
  attachmentType String?  // IMAGE | DOCUMENT
  readAt         DateTime?
  createdAt      DateTime @default(now())
}

model Review {
  id           String   @id @default(cuid())
  orderId      String   @unique
  order        Order    @relation(fields: [orderId], references: [id])
  studentId    String
  student      User     @relation("ReviewsGiven", fields: [studentId], references: [id])
  writerId     String
  writer       User     @relation("ReviewsReceived", fields: [writerId], references: [id])
  overall      Int      // 1–5
  handwriting  Int
  accuracy     Int
  neatness     Int
  communication Int
  onTime       Int
  text         String   @default("")
  createdAt    DateTime @default(now())
}

model Transaction {
  id        String   @id @default(cuid())
  writerId  String
  writer    User     @relation(fields: [writerId], references: [id])
  orderId   String?
  type      String   // EARNING | PAYOUT
  amount    Int      // ₹, positive for earning
  status    String   @default("PENDING") // PENDING | ELIGIBLE | PAID
  note      String   @default("")
  createdAt DateTime @default(now())
}

model PlatformConfig {
  key   String @id
  value String
}

model OtpCode {
  id        String   @id @default(cuid())
  phone     String
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([phone])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String    @default("")
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())
}
